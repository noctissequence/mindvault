# --- Database (SQLite file) ---
# NOTE: a relative path resolves against the prisma/ directory, not the project
# root. "../data/..." therefore lands in <project>/data/ — matching the Docker
# volume and the default .gitignore.
DATABASE_URL="file:../data/mindvault.db"

# --- Auth (REQUIRED in production) ---
# Generate: openssl rand -hex 32
# The app refuses to start if this is missing while NODE_ENV=production.
JWT_SECRET="change-me-to-64-hex-chars"

# --- Public URL of the app (used in bot messages / Mini App button) ---
APP_URL="https://mindvault.example.com"
# Telegram Mini App URL (usually https://your-domain/mini)
TELEGRAM_WEBAPP_URL=""

# --- Telegram bot (optional but recommended) ---
# Get from @BotFather. Leave empty to run without Telegram.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Secret for webhook mode: set a random string, sent as X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=""

NODE_ENV="production"
